# Build environment
PYTORCH_VERSION=2.12.0
CUDA_VERSION=13.0.0
TORCH_CUDA_ARCH_LIST=7.5;8.0;8.6;8.9;9.0;10.0;12.0;12.1
ROCM_VERSION=7.2
PYTORCH_ROCM_ARCH=gfx950

# Package versions
XFORMERS_VERSION=0.0.35
PYTORCH_CLUSTER_VERSION=1.6.3
PYTORCH_SPARSE_VERSION=0.6.18
PYTORCH_SCATTER_VERSION=2.1.2
TORCHAO_VERSION=0.16.0
FLASH_ATTN_VERSION=2.8.3
FLASH_ATTN_4_TAG=fa4-v4.0.0.beta8
AITER_VERSION=v0.1.19.post2
MORI_VERSION=v1.2.2
MORI_GPU_ARCHS=gfx942;gfx950
VLLM_VERSION=0.26.0
MSLK_VERSION=1.1.0
ATOM_VERSION=0.1.5

# torchtitan: PyTorch-native LLM training platform (pure-Python wheel).
# Pin matches milabench benchmarks/torchtitan/requirements.toml (git ref -> assets/version.txt).
TORCHTITAN_REF=ecae62f1591c3a73ed78a25d7c68f249bd61caa6

# Intel XPU (oneAPI) — GPU_BACKEND=xpu
# ONEAPI_VERSION: Intel oneAPI Toolkit version used by ci-install-oneapi.sh.
# XPU_AOT_DEVLIST: comma-separated SYCL AOT targets for ahead-of-time kernel compilation.
#   "pvc"      → Data Center GPU Max Series (Ponte Vecchio / Xe-HPC)
#   "acm-g10"  → Arc A770/A750 (Alchemist / Xe-HPG high-end)
#   Leave empty to rely on SPIR-V JIT at runtime (works on all Intel GPUs).
ONEAPI_VERSION=2026.1
XPU_AOT_DEVLIST=pvc
